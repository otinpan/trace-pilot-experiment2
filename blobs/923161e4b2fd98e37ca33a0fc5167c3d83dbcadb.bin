 a.external.autonumber[href^=3D"//"]::after { content: ' (https:' attr(href=
) ')'; }
  .wikitable { background: rgb(255, 255, 255); margin: 1em 0px; border: 1pt=
 solid rgb(170, 170, 170); border-collapse: collapse; font-size: 10pt; brea=
k-inside: avoid; }
  .wikitable > caption { padding: 5px; font-size: 10pt; }
  .wikitable > tr > th, .wikitable > tr > td, .wikitable > * > tr > th, .wi=
kitable > * > tr > td { border: 1pt solid rgb(170, 170, 170); padding: 0.4e=
