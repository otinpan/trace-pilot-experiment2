operty: opacity; transition-duration: 0.25s; transition-timing-function: ea=
se; }

.cdx-message-leave-active-user { transition-property: opacity; transition-d=
uration: 0.25s; transition-timing-function: ease-out; }

.cdx-message-enter-from, .cdx-message-leave-to { opacity: 0; }
