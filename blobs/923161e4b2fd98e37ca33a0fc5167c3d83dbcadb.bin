fter, .mw-content-ltr figure[typeof~=3D"mw:File/Thumb"] > .mw-file-magnify:=
:after { right: 6px; left: auto; background-image: url("/w/resources/src/me=
diawiki.skinning/images/magnify-clip-ltr.svg?8330e"); }

