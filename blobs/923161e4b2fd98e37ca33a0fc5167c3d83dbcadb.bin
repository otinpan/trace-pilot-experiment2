.mw-contributions-blocked-notice-partial .mw-warning-with-logexcerpt.mw-war=
ning-with-logexcerpt { border-color: rgb(255, 204, 51); background-color: v=
ar(--background-color-warning-subtle,#fef6e7); }

.citation:target { background-color: var(--background-color-progressive-sub=
tle,rgb(0 127 255 / 0.133)); }

.nowrap, .nowraplinks a, sup.reference a { white-space: nowrap; }

.wrap, .wraplinks a { white-space: normal; }

