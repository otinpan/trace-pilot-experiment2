.ext-qs-loader-bar .mw-spinner-container { transform: scale(0.5); transform=
-origin: center center; width: 25%; height: 75%; }

.ext-quick-survey-panel { overflow-wrap: anywhere; }

@media (min-width: 640px) {
  .ext-qs-loader-bar, .ext-quick-survey-panel { margin-left: 1.4em; width: =
300px; clear: right; float: right; }
}

.mw-body > .content .panel.ext-quick-survey-panel { text-align: initial; }

.mw-body > .content .panel.ext-quick-survey-panel .image { background-posit=
ion: center 80%; background-repeat: no-repeat; background-size: auto 5em; }

@media print {
  .ext-quick-survey-panel { display: none; }
}
