=A1=E3=82=A4=E3=83=B3=E3=83=9A=E3=83=BC=E3=82=B8 #contentSub2 { display: no=
ne; }

.plainlist ol, .plainlist ul { line-height: inherit; list-style: none; marg=
in: 0px; }

.plainlist ol li, .plainlist ul li { margin-bottom: 0px; }

span.texhtml { font-family: "Nimbus Roman No9 L", "Times New Roman", Times,=
 serif; font-size: 108%; line-height: 1; white-space: nowrap; font-feature-=
settings: "lnum", "tnum", "kern" 0; font-variant-numeric: lining-nums tabul=
ar-nums; font-kerning: none; }

span.texhtml span.texhtml { font-size: 100%; }

span.mwe-math-mathml-inline { font-size: 108%; }

.mwe-math-fallback-image-display, .mwe-math-mathml-display { margin-top: 0.=
6em; margin-bottom: 0.6em; margin-left: 1.6em !important; }

.mwe-math-mathml-display math { display: inline; }

span.texhtml sup { vertical-align: 1ex; font-size: 75%; }

span.texhtml sub { vertical-align: -0.5ex; font-size: 75%; }

.ve-not-available .editsection-extensions .mw-editsection-divider { display=
: inline; }

#bodyContent { overflow-wrap: break-word; }

.mw-special-Book #coll-downloadbox { display: none; }

span[rel=3D"mw:referencedBy"]::before { content: "^ "; }

a[rel=3D"mw:referencedBy"]::before { font-weight: bold; content: "^"; }

span[rel=3D"mw:referencedBy"] { counter-reset: mw-ref-linkback 0; }

span[rel=3D"mw:referencedBy"] > a::before { font-weight: bold; font-style: =
italic; content: counter(mw-ref-linkback, lower-alpha); }

.checkuser-show, .sysop-show, .eliminator-show, .abusefilter-show, .extende=
dconfirmed-show, .autoconfirmed-show, .user-show { display: none; }

html.skin-theme-clientpref-night .tmpl-language-icon { color: white !import=
ant; }

@media screen and (prefers-color-scheme: dark) {
  html.skin-theme-clientpref-os .tmpl-language-icon { color: white !importa=
nt; }
}

#siteNotice li { text-align: start; }

.vector-feature-custom-font-size-clientpref-0 #bodyContent, .vector-feature=
-custom-font-size-clientpref--excluded #bodyContent { font-size: calc(0.944=
em); }

#coordinates { position: absolute; right: 0px; top: 0px; font-size: 85%; li=
ne-height: 1.2em; }

#siteSub { display: block; }

@media print {
  .ns--1 .ambox, .ns-0 .ambox, .ns--1 .navbox, .ns-0 .navbox, .mediawiki.ns=
--1 .mw-parser-output .sidebar, .mediawiki.ns-0 .mw-parser-output .sidebar,=
 .ns--1 .dablink, .ns-0 .dablink, .ns--1 .metadata, .ns-0 .metadata, .editl=
ink, .navbar, a.NavToggle, span.collapseButton, span.mw-collapsible-toggle,=
 .nourlexpansion a.external.text::after, .nourlexpansion a.external.autonum=
ber::after { display: none !important; }
  .editsection-moved { display: none; }
  div.NavContent, ul.NavContent, .mw-parser-output .mw-collapsed .mw-collap=
sible-content { display: block !important; }
  table.collapsible tr, .mw-parser-output table.mw-collapsed > * > tr { dis=
play: table-row !important; }
  .mw-parser-output ol.mw-collapsed > li, .mw-parser-output ul.mw-collapsed=
 > li { display: list-item !important; }
  #firstHeading { margin: 0px; }
  .printfooter { clear: both; }
}
