"mw:File/Thumb"] > .mw-file-magnify { display: block; position: relative; }

figure[typeof~=3D"mw:File/Thumb"] > .mw-file-description::after, figure[typ=
eof~=3D"mw:File/Thumb"] > .mw-file-magnify::after { content: ""; width: 15p=
x; height: 11px; position: absolute; bottom: -11px; right: 6px; background-=
image: url("/w/resources/src/mediawiki.skinning/images/magnify-clip-ltr.svg=
?8330e"); }

