ht: var(--line-height-body); }

*, ::before, ::after { box-sizing: inherit; }

::before, ::after { box-sizing: inherit; background-repeat: no-repeat; text=
-decoration: inherit; vertical-align: inherit; }

hr { overflow: visible; height: 0px; border: 0px; }

details, main { display: block; }

