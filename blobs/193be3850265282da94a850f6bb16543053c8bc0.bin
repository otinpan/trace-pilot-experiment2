ation-delay: -0.2s; }

.mw-spinner-container > div:nth-child(11) { transform: rotate(300deg); anim=
ation-delay: -0.1s; }

.mw-spinner-container > div:nth-child(12) { transform: rotate(330deg); anim=
ation-delay: 0s; }

