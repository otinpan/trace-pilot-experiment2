tion-delay: -0.5s; }

.mw-spinner-container > div:nth-child(8) { transform: rotate(210deg); anima=
tion-delay: -0.4s; }

.mw-spinner-container > div:nth-child(9) { transform: rotate(240deg); anima=
tion-delay: -0.3s; }

